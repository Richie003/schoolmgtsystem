# ---- API location ----
# Base URL of the Django API, including the /api path and NO trailing slash.
#
# Local dev: you can leave this UNSET. The Vite dev server proxies /api and
# /media to the backend (see vite.config.ts), and the app falls back to a
# relative "/api", so everything is same-origin and CORS-free.
#
# Production: the SPA and API are deployed to different servers, so you MUST set
# this to the API's public URL. Vite inlines it at build time.
# VITE_API_BASE_URL=https://api.your-school-domain.com/api

# ---- Dev proxy target (optional) ----
# Where the dev server forwards /api and /media. Defaults to http://localhost:8000.
# VITE_DEV_PROXY_TARGET=http://localhost:8000
