# ---- Django ----
SECRET_KEY=change-me-generate-with-get_random_secret_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC
LOG_LEVEL=INFO

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/school_management

# ---- Redis / Celery ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Set True to run Celery tasks inline (no worker needed) during local dev.
CELERY_TASK_ALWAYS_EAGER=False

# ---- JWT ----
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- File storage ----
# Leave AWS_STORAGE_BUCKET_NAME empty to use local media storage (dev only).
# Set it to enable S3 for all CSV uploads (required in production).
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1

# ---- Limits ----
CSV_MAX_ROWS=10000
CSV_MAX_UPLOAD_BYTES=10485760
EXAM_SUBMIT_GRACE_SECONDS=10
