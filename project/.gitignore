# Repository-wide ignores. Each subproject has its own .gitignore for the
# language-specific stuff:
#   backend/.gitignore   — venv, __pycache__, db.sqlite3, media, .env …
#   frontend/.gitignore  — node_modules, dist, .env …

# ---- Secrets (never commit a real env file anywhere) ----
.env
.env.*
!.env.example

# ---- OS / editor ----
.DS_Store
.idea
.vscode/*
!.vscode/extensions.json
*.suo
*.sw?

# ---- Logs ----
logs
*.log
*.docx
PROPOSAL-Topline.md
PROPOSAL.md